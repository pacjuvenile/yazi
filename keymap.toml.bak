[mgr]
prepend_keymap = [
	{ on = "y", run = [ "yank", "plugin wsl-clipboard -- sync" ] },
	{ on = "x", run = [ "yank --cut", "plugin wsl-clipboard -- sync" ] },
	{ on = "p", run = "plugin wsl-clipboard -- paste" },
	{ on = "P", run = "plugin wsl-clipboard -- paste --force" },
	{ on = "i", run = "plugin wsl-clipboard -- image" },
	{ on = "I", run = "plugin wsl-clipboard -- image --force" },
	{ on = "Y", run = [ "unyank", "plugin wsl-clipboard -- clear" ] },
	{ on = "X", run = [ "unyank", "plugin wsl-clipboard -- clear" ] },
]
